import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt
plt.style.use('ggplot')
%matplotlib inline
import matplotlib as mpl
mpl.rcParams['figure.figsize'] = (12, 8) 
# Read in the data
df = pd.read_csv(r'C:\Users\Brian Otto\Documents\Career\Training\Data Analyst Training\Portfolio_Projects\Movie Correlation\movies_dataset.csv')
# Look at the data
df.head()
# Checking for any missing data. 
for col in df.columns:
    pct_missing = np.mean(df[col].isnull())
    print('{} - {}%'.format(col, pct_missing))
# Date types for columns. 
df.dtypes
df['budget'] = pd.to_numeric(df['budget'], errors='coerce').fillna(0).astype('int64')
df['gross'] = pd.to_numeric(df['gross'], errors='coerce').fillna(0).astype('int64')
# Cast budget and gross to int64
df['budget'] = df['budget'].astype('int64')
df['gross'] = df['gross'].astype('int64')
df.dtypes
